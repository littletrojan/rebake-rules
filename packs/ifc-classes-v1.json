{
  "schema_version": 1,
  "id": "rebake-builtin-ifc-classes",
  "version": "1.2.0",
  "name": "Rebake built-in IFC classes (v1)",
  "description": "Allowlist of valid IFC 4.3 entity classes per Rebake element kind. The default rule pack shipped with Rebake. Adding a class is a one-line edit; bump version on any change.",
  "category": "ifc",
  "severity": "warning",
  "allowlist": [
    {
      "applies_to": "wall",
      "allowed": [
        "IfcWall",
        "IfcWallStandardCase",
        "IfcCurtainWall"
      ]
    },
    {
      "applies_to": "slab",
      "allowed": [
        "IfcSlab",
        "IfcSlabStandardCase",
        "IfcRoof",
        "IfcCovering"
      ]
    },
    {
      "applies_to": "space",
      "allowed": [
        "IfcSpace",
        "IfcZone"
      ]
    },
    {
      "applies_to": "opening",
      "allowed": [
        "IfcDoor",
        "IfcDoorStandardCase",
        "IfcWindow",
        "IfcWindowStandardCase"
      ]
    },
    {
      "applies_to": "level",
      "allowed": [
        "IfcBuildingStorey",
        "IfcBuilding",
        "IfcSite"
      ]
    }
  ]
}
